# --- Mode -------------------------------------------------------------------
# paper : simulated fills on live testnet market data (no API key needed)
# live  : real testnet orders (API key + Account ID required)
MODE=paper

# --- Credentials (MODE=live only) --------------------------------------------
# API key: Polyester app -> sidebar API. Private key is shown once at creation.
# Account ID: Polyester app -> Profile -> Account ID.
# Grant the key: Spot trading + ledger read. Set a max order size on the key.
API_KEY_ID=
API_PRIVATE_KEY=
ACCOUNT_ID=

# --- Market ------------------------------------------------------------------
SYMBOL=BTC-USDT
TIMEFRAME=1m

# --- Sizing & protection ------------------------------------------------------
# Quote budget per trade (decimal string). BUY is quote-budget all-in.
TRADE_BUDGET_QUOTE=25.00
# Market IOC slippage protection, 1..10000 bps (100 = 1%).
MAX_SLIPPAGE_BPS=50

# --- Strategy (EMA 9/21 cross + ROC + volume surge) ---------------------------
STOP_LOSS_BPS=100        # SL 1% below avg entry
TAKE_PROFIT_BPS=200      # TP 2% above avg entry
ROC_PERIOD=5             # lookback in candles
ROC_THRESHOLD_PCT=0.3    # minimum ROC % to confirm momentum
VOLUME_SURGE_MULT=1.5    # candle volume vs mean of previous N candles
EMA_FAST=9
EMA_SLOW=21
VOL_MA_PERIOD=20
WARMUP_CANDLES=150       # REST candles used to seed indicators at boot

# --- Risk ----------------------------------------------------------------------
DAILY_LOSS_LIMIT_PCT=5   # % of day-start equity; trip => kill switch
DEAD_MAN_TIMEOUT_SEC=15  # live: CancelAllAfter window
DEAD_MAN_REFRESH_SEC=5   # live: refresh interval (must be < timeout)
RECONCILE_POLL_SEC=30    # live: invariant-check interval

# --- Brain (multi-factor decision gate) -----------------------------------------
# Buy signals must clear a 0-100 score built from: trend drift vs ATR, RSI
# zone, volume confirmation, breakout position, ROC, choppiness penalty.
# 0 = brain off (every EMA-cross signal trades). Cooldown pauses a symbol
# after a losing cycle so one bad market can't bleed the account.
BRAIN_MIN_SCORE=60
BRAIN_COOLDOWN_MIN=10

# --- Wire price scale ------------------------------------------------------------
# 0 = auto-detect from candle quote_volume/volume at boot (recommended).
# Set 9 manually if detection fails (observed testnet feeds: ticks=true×10^9).
POLYESTER_PRICE_SCALE=0

# --- Housekeeping ----------------------------------------------------------------
STATE_DIR=state          # journal (idempotency) directory
FLATTEN_ON_SHUTDOWN=true # sell open position on SIGINT/SIGTERM

# --- Paper mode -------------------------------------------------------------------
PAPER_START_QUOTE=1000.00
