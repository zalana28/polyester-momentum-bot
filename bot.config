# ============================================================
#  PENGATURAN BOT — edit file ini lewat menu: ./bot.sh (4)
#  Setelah edit, restart bot lewat menu supaya berefek.
# ============================================================

# MODE bot: vip  = push volume VIP (beli+jual market terus-menerus)
#           dip  = maker mean-reversion (beli dip, jual +60bps)
#           off  = bot tidak jalan
MODE=vip

# Pair yang diperdagangkan (pisahkan dengan koma, tanpa spasi)
PAIRS=USDC-USDT,LTC-USDT,BTC-USDT

# Modal per trade/siklus (USD). VIP: minimal 400. Dip: minimal 1000.
BUDGET_USD=600

# Jeda antar trade selesai (detik) — ramah API
REST_SEC=4

# [MODE=vip] Bot berhenti permanen bila USDT bebas di bawah nilai ini
MIN_FREE_USD=500

# [MODE=dip] Berhenti bila rugi dari puncak melebihi ini (USD)
MAX_LOSS_USD=25
